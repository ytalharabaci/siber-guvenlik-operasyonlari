---
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default />

<div class="companion-grid">
	<div class="companion-card">
		<div class="companion-content">
			<span class="companion-tag">Ağ Altyapısı Kitabı</span>
			<h4 class="companion-title">Ağ Yönetimi ve Güvenliği</h4>
			<p class="companion-desc">
				TCP/IP ve QUIC protokol anatomisi, BGP/RPKI yönlendirme güvenliği, Suricata IDS/IPS sistemleri, SASE & SD-WAN mimarisi ve NetDevOps otomasyonu.
			</p>
		</div>
		<a href="https://ytalharabaci.github.io/ag-yonetimi-ve-guvenligi/" class="companion-link" target="_blank" rel="noopener">
			Kitabı İncele →
		</a>
	</div>

	<div class="companion-card">
		<div class="companion-content">
			<span class="companion-tag">Şifreleme & Kriptanaliz Kitabı</span>
			<h4 class="companion-title">Uygulamalı Kriptoloji</h4>
			<p class="companion-desc">
				Kriptografik temeller, AES/ChaCha20, RSA/ECC, TLS 1.3 el sıkışması, PQC (Kyber/Dilithium), ZKP ve blokzincir mutabakat matematiği.
			</p>
		</div>
		<a href="https://ytalharabaci.github.io/uygulamali-kriptoloji/" class="companion-link" target="_blank" rel="noopener">
			Kitabı İncele →
		</a>
	</div>
</div>

<p class="license">
	© 2026 Yusuf Talha ARABACI. Bu eser
	<a href="https://creativecommons.org/licenses/by/4.0/deed.tr" rel="license">CC BY 4.0</a>
	lisansı ile lisanslanmıştır; atıf yapılarak serbestçe kullanılabilir ve paylaşılabilir.
</p>

<style>
	.companion-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
		margin-top: 2rem;
	}
	@media (min-width: 60rem) {
		.companion-grid {
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		}
	}
	.companion-card {
		background: var(--sl-color-gray-6);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		padding: 1.25rem;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1rem;
		transition: border-color 0.2s ease, transform 0.2s ease;
	}
	.companion-card:hover {
		border-color: var(--sl-color-accent);
		transform: translateY(-2px);
	}
	.companion-tag {
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--sl-color-accent);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 0.35rem;
	}
	.companion-title {
		margin: 0 0 0.5rem 0;
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.companion-desc {
		margin: 0;
		font-size: 0.85rem;
		color: var(--sl-color-gray-3);
		line-height: 1.45;
	}
	.companion-link {
		align-self: flex-start;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--sl-color-accent);
		text-decoration: none;
		border-bottom: 1px dashed var(--sl-color-accent);
		padding-bottom: 2px;
		transition: color 0.15s ease, border-color 0.15s ease;
	}
	.companion-link:hover {
		color: var(--sl-color-white);
		border-bottom-style: solid;
	}
	.license {
		margin-top: 2rem;
		padding-top: 1rem;
		border-top: 1px solid var(--sl-color-gray-5);
		font-size: 0.8rem;
		color: var(--sl-color-gray-3);
		text-align: center;
	}
	.license a {
		color: var(--sl-color-accent);
		text-decoration: underline;
	}
</style>
